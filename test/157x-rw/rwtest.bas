10 REM 1541 1571 READ WRITE TEST
20 PRINT CHR$(147):PRINT "1541/1571 READ/WRITE TEST"
30 D=8:INPUT "DEVICE (8 OR 9)";D
40 IF D<>8 AND D<>9 THEN 30
50 OPEN15,D,15:INPUT#15,E,M$,T,S
60 IF E<>73 AND E<>0 THEN 900
70 OPEN4,D,4,"SIDE1DAT,S,R":INPUT#4,A$:CLOSE4
80 IF A$<>"SIDE1 OK" THEN PRINT "SIDE DATA FAILED":GOTO950
90 PRINT#15,"S0:RWTEMP":INPUT#15,E,M$,T,S
100 OPEN2,D,2,"0:RWTEMP,S,W"
110 FOR I=1 TO 100
120 A=I*37+11:B=A*13+7
130 PRINT#2,I;",";A;",";B
140 NEXT I:CLOSE2
150 INPUT#15,E,M$,T,S:IF E<>0 THEN 900
160 OPEN2,D,2,"0:RWTEMP,S,R"
170 FOR I=1 TO 100
180 INPUT#2,J,A,B:X=I*37+11:Y=X*13+7
190 IF J<>I OR A<>X OR B<>Y THEN 920
200 NEXT I:CLOSE2
210 PRINT#15,"S0:RWTEMP":INPUT#15,E,M$,T,S
220 IF E<>1 AND E<>0 THEN 900
230 PRINT "PASS ON DEVICE";D:CLOSE15:END
900 PRINT "DRIVE ERROR";E;M$;T;S:GOTO950
920 PRINT "VERIFY ERROR RECORD";I
950 CLOSE2:CLOSE4:CLOSE15:END
